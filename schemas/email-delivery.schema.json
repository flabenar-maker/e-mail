{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "email_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_version": {
      "type": "string",
      "minLength": 1
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "inventory_digest": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string"
    },
    "preheader": {
      "type": "string"
    },
    "sender": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "inherit"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "explicit"
            },
            "name": {
              "type": "string"
            },
            "address": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "mode",
            "name",
            "address"
          ]
        }
      ]
    },
    "reply_to": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "inherit"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "explicit"
            },
            "name": {
              "type": "string"
            },
            "address": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "mode",
            "name",
            "address"
          ]
        }
      ]
    },
    "plain_text": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "auto"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "manual"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "mode",
            "value"
          ]
        }
      ]
    },
    "answers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "email_id",
    "profile_id",
    "profile_version",
    "source_sha",
    "inventory_digest",
    "subject",
    "preheader",
    "sender",
    "reply_to",
    "plain_text",
    "answers"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local.cupis/email-delivery.schema.json",
  "title": "Local email delivery inputs"
}
