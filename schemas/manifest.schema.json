{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flabenar-maker/e-mail/schemas/manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "system",
    "entrypoints",
    "sources",
    "bundle_profiles",
    "routes",
    "skills",
    "plugins",
    "figma",
    "bootstrap",
    "commands"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "bootstrap"],
      "properties": {
        "repository": { "$ref": "#/$defs/repoPath" },
        "bootstrap": { "$ref": "#/$defs/repoPath" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source" }
    },
    "bundle_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/bundleProfile" }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/route" }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/skill" }
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/skill" }
        }
      }
    },
    "plugins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "figma": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_key", "roots"],
      "properties": {
        "file_key": { "$ref": "#/$defs/nonEmptyString" },
        "roots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["marketing", "service"],
          "properties": {
            "marketing": { "$ref": "#/$defs/figmaNodeId" },
            "service": { "$ref": "#/$defs/figmaNodeId" }
          }
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portable_config", "verifier"],
      "properties": {
        "portable_config": { "$ref": "#/$defs/repoPath" },
        "verifier": { "$ref": "#/$defs/repoPath" }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validate", "test", "verify"],
      "properties": {
        "validate": { "$ref": "#/$defs/nonEmptyString" },
        "test": { "$ref": "#/$defs/nonEmptyString" },
        "verify": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "figmaNodeId": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": [
            "entrypoint",
            "core",
            "registry",
            "workflow",
            "template",
            "schema",
            "generated"
          ]
        },
        "path": { "$ref": "#/$defs/repoPath" }
      }
    },
    "bundleProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workflow_source_id", "bundle_profile_id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "workflow_source_id": { "$ref": "#/$defs/id" },
        "bundle_profile_id": { "$ref": "#/$defs/id" }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/repoPath" }
      }
    }
  }
}
