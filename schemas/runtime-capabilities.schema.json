{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "runtime-capabilities",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "runtime_session_id": {
      "type": "string",
      "minLength": 1
    },
    "tool_signature": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "const": "declared-runtime-tools"
    },
    "max_subagents": {
      "type": "integer",
      "minimum": 1
    },
    "refusals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "runtime_session_id": {
            "type": "string",
            "minLength": 1
          },
          "tool_signature": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "enum": [
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              "ultra"
            ]
          },
          "code": {
            "enum": [
              "MODEL_UNAVAILABLE",
              "EFFORT_UNAVAILABLE",
              "CAPABILITY_UNAVAILABLE"
            ]
          },
          "selected_model": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "binding": {
                    "const": "explicit"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "binding",
                  "id"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "binding": {
                    "const": "inherited"
                  },
                  "id": {
                    "type": "null"
                  }
                },
                "required": [
                  "binding",
                  "id"
                ]
              }
            ]
          }
        },
        "required": [
          "runtime_session_id",
          "tool_signature",
          "effort",
          "code",
          "selected_model"
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "selected_model": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "binding": {
              "const": "explicit"
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "binding",
            "id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "binding": {
              "const": "inherited"
            },
            "id": {
              "type": "null"
            }
          },
          "required": [
            "binding",
            "id"
          ]
        }
      ]
    },
    "supported_efforts": {
      "type": "array",
      "items": {
        "enum": [
          "none",
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "max",
          "ultra"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "text",
          "code",
          "vision"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "runtime_session_id",
    "tool_signature",
    "source",
    "max_subagents",
    "selected_model",
    "supported_efforts",
    "capabilities"
  ]
}
