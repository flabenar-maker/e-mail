{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flabenar-maker/e-mail/schemas/spacing.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "foundation",
    "viewports",
    "roles",
    "global_invariants",
    "exceptions",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "const": "spacing"
        },
        "status": {
          "const": "shadow"
        }
      }
    },
    "viewports": {
      "type": "array",
      "const": [
        "mobile",
        "desktop"
      ]
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/role"
      }
    },
    "global_invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/invariant"
      }
    },
    "exceptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/exception"
      }
    },
    "provenance": {
      "$ref": "#/$defs/foundationProvenance"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\^@]+$"
    },
    "figmaNodeId": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+$"
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_px",
        "provenance"
      ],
      "properties": {
        "value_px": {
          "type": "integer",
          "minimum": 0
        },
        "provenance": {
          "oneOf": [
            {
              "$ref": "#/$defs/registryLiteralProvenance"
            },
            {
              "$ref": "#/$defs/figmaVariableProvenance"
            }
          ]
        }
      }
    },
    "registryLiteralProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_blob_sha"
      ],
      "properties": {
        "kind": {
          "const": "registry-literal"
        },
        "source_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "figmaVariableProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "file_key",
        "evidence_node_id",
        "field_path",
        "variable_id",
        "variable_name",
        "variable_resolved_type",
        "captured_at"
      ],
      "properties": {
        "kind": {
          "const": "figma-variable"
        },
        "file_key": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_node_id": {
          "$ref": "#/$defs/figmaNodeId"
        },
        "field_path": {
          "type": "string",
          "pattern": "^/(?:paddingTop|paddingRight|paddingBottom|paddingLeft|itemSpacing|counterAxisSpacing)$"
        },
        "variable_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "variable_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "variable_resolved_type": {
          "const": "FLOAT"
        },
        "captured_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "relationship_path"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "relationship_path": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "relationship",
        "owner",
        "purpose",
        "applicability",
        "resolutions",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "relationship": {
          "enum": [
            "email-outer-flow",
            "email-common-inset",
            "component-self-inset",
            "component-container-padding",
            "component-section-stack",
            "collection-section-stack",
            "repeated-visual-item-stack",
            "details-row-stack",
            "inline-peer-gap",
            "text-stack",
            "asset-to-content",
            "control-content",
            "fixed-geometry-offset",
            "optical-compensation"
          ]
        },
        "owner": {
          "enum": [
            "email-shell",
            "top-level-component-root",
            "component-content-container",
            "nested-component",
            "collection-container",
            "repeated-item-parent",
            "details-rows-parent",
            "inline-parent",
            "text-group",
            "asset-content-parent",
            "interactive-control",
            "component-geometry"
          ]
        },
        "purpose": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "applicability": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "top-level",
              "nested",
              "common-padding",
              "self-inset",
              "primary-surface",
              "compact-surface",
              "collection",
              "repeated-items",
              "details",
              "inline",
              "compact",
              "text",
              "control"
            ]
          }
        },
        "resolutions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mobile",
            "desktop"
          ],
          "properties": {
            "mobile": {
              "$ref": "#/$defs/resolution"
            },
            "desktop": {
              "$ref": "#/$defs/resolution"
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "statement": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component_id",
        "viewport",
        "relationship_path",
        "value_px",
        "reason_category",
        "rationale",
        "evidence_node_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "component_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "viewport": {
          "enum": [
            "mobile",
            "desktop"
          ]
        },
        "relationship_path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "value_px": {
          "type": "integer",
          "minimum": 0
        },
        "reason_category": {
          "enum": [
            "optical-compensation",
            "fixed-geometry",
            "component-specific"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_node_id": {
          "$ref": "#/$defs/figmaNodeId"
        }
      }
    },
    "foundationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_commit",
        "registry_blob_sha",
        "design_spec_path"
      ],
      "properties": {
        "base_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "registry_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "design_spec_path": {
          "$ref": "#/$defs/repoPath"
        }
      }
    }
  }
}
