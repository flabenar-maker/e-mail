      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_identity",
        "same_program_local_and_cloud",
        "direct_node_requires_same_lock",
        "cloud_terminal_conclusions",
        "local_offer_choices",
        "local_offer_once_per_execution",
        "local_offer_runs_tests",
        "local_offer_runs_collector",
        "local_only_can_pass_cloud"
