        "source_identity": {
          "const": "exact-sha"
        },
        "same_program_local_and_cloud": {
          "const": true
        },
        "direct_node_requires_same_lock": {
          "const": true
        },
        "cloud_terminal_conclusions": {
          "const": [
            "success",
            "failure",
            "cancelled",
            "timed_out",
            "infrastructure-error"
          ]
        },
        "local_offer_choices": {
          "const": [
            "lightweight",
            "full-later",
            "skip-additional"
          ]
        },
        "local_offer_once_per_execution": {
          "const": true
        },
        "local_offer_runs_tests": {
          "const": false
        },
        "local_offer_runs_collector": {
          "const": false
        },
        "local_only_can_pass_cloud": {
          "const": false
