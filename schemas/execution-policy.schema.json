            "additionalProperties": false,
            "required": [
              "concurrency",
              "timeout_minutes",
              "max_heavy_batches"
            ],
            "properties": {
              "concurrency": {
                "const": 2
              },
              "timeout_minutes": {
                "const": 30
              },
              "max_heavy_batches": {
                "const": 1
              }
            }
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "executable",
                "args"
              ],
              "properties": {
                "executable": {
                  "enum": [
                    "node",
                    "powershell"
                  ]
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              }
            },
            "minItems": 1
          }
        }
      },
      "minItems": 6
