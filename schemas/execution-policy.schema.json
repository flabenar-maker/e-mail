                "uniqueItems": true,
                "minItems": 1
              },
              "node_major": {
                "const": 24
              },
              "runtimes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "same_lock_dependencies": {
                "const": true
              }
            }
