{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flabenar-maker/e-mail/schemas/typography.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "foundation",
    "styles",
    "responsive_pairs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source"
      ],
      "properties": {
        "id": {
          "const": "typography"
        },
        "status": {
          "enum": ["shadow", "active"]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "styles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/style"
      }
    },
    "responsive_pairs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/responsivePair"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "figma_file_key",
        "page_node_id",
        "verified_at"
      ],
      "properties": {
        "figma_file_key": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "page_node_id": {
          "type": "string",
          "pattern": "^[0-9]+:[0-9]+$"
        },
        "verified_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "figma_style",
        "css_weight"
      ],
      "properties": {
        "family": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "figma_style": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "css_weight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900,
          "multipleOf": 100
        }
      }
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "value"
      ],
      "properties": {
        "unit": {
          "enum": [
            "percent",
            "px"
          ]
        },
        "value": {
          "type": "number"
        }
      }
    },
    "positiveMeasure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "value"
      ],
      "properties": {
        "unit": {
          "enum": [
            "percent",
            "px"
          ]
        },
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "figma_name",
        "figma_style_id",
        "viewport",
        "role",
        "variant",
        "font",
        "font_size_px",
        "line_height",
        "letter_spacing",
        "figma_description_semantics"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "figma_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "viewport": {
          "enum": [
            "desktop",
            "mobile"
          ]
        },
        "role": {
          "enum": [
            "display",
            "heading",
            "title",
            "body",
            "caption",
            "action"
          ]
        },
        "variant": {
          "enum": [
            "default",
            "compact",
            "large",
            "medium"
          ]
        },
        "font": {
          "$ref": "#/$defs/font"
        },
        "font_size_px": {
          "type": "integer",
          "minimum": 1
        },
        "line_height": {
          "$ref": "#/$defs/positiveMeasure"
        },
        "letter_spacing": {
          "$ref": "#/$defs/measure"
        },
        "figma_style_id": {
          "type": "string",
          "pattern": "^S:[A-Za-z0-9]+,$"
        },
        "figma_description_semantics": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "responsivePair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "desktop_style_id",
        "mobile_style_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "display",
            "heading",
            "title",
            "body",
            "caption",
            "action"
          ]
        },
        "desktop_style_id": {
          "$ref": "#/$defs/id"
        },
        "mobile_style_id": {
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
